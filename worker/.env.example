# --- Storage ---
STORAGE_DIR=./storage              # uploads, frames, clips

# --- Database (shared with the .NET API; .NET owns the schema) ---
DATABASE_URL=postgresql+asyncpg://pitchwise:pitchwise@localhost:5432/pitchwise

# --- Queue ---
REDIS_URL=redis://localhost:6379
# When 1: analysis runs synchronously in-request (no Redis/worker). Handy for MVP/dev.
ANALYSIS_INLINE=0

# --- LLM (switchable; protocol compatible with OpenAI Chat Completions) ---
# Switch provider by changing base_url + api_key + model. No vendor-specific SDK.
LLM_PROVIDER=openai                # any descriptive label
LLM_BASE_URL=https://api.openai.com/v1   # OpenAI: .../v1 ; Ollama: http://localhost:11434/v1
LLM_API_KEY=                       # provider key (empty for Ollama)
LLM_MODEL=gpt-4o-mini              # Ollama e.g. llama3.1 ; cheaper: gpt-4o-mini

# --- Vision ---
# Path to a trained YOLO model (players/ball/referee). Empty = download/fine-tune.
YOLO_MODEL_PATH=
# Which frames are analyzed (1 = every frame; higher = faster, less accurate).
FRAME_STRIDE=5
# Seconds before/after an event cut into the highlight clip.
CLIP_PRE_SECONDS=6
CLIP_POST_SECONDS=4

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
