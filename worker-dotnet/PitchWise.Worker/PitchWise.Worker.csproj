<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>pitchwise-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.*" />
    <!-- Pin EF Core to the same version the API resolves (9.0.*) so the shared
         AppDbContext assembly loads without a version-conflict (CS1705). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vision core (YOLO11 ONNX + ByteTrack + events + ffmpeg). -->
    <ProjectReference Include="..\PitchWise.Vision\PitchWise.Vision.csproj" />
    <!-- Shared DB schema: reuse the API's AppDbContext, entities, enums, AppSettings —
         single source of truth for the Postgres contract with the (retiring) Python worker. -->
    <ProjectReference Include="..\..\api-dotnet\PitchWise.Api.csproj" />
  </ItemGroup>

</Project>
