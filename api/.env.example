# --- Storage ---
STORAGE_DIR=./storage              # uploady, klatki, klipy
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# --- Kolejka ---
REDIS_URL=redis://localhost:6379
# Gdy 1: analiza uruchamiana synchronicznie w request (bez Redis/workera). Wygodne do MVP/dev.
ANALYSIS_INLINE=0

# --- LLM (przełączalny; protokół zgodny z OpenAI Chat Completions) ---
# Przełączasz dostawcę zmieniając base_url + api_key + model. Bez SDK konkretnego vendora.
LLM_PROVIDER=anthropic             # dowolna etykieta; opisowa
LLM_BASE_URL=https://api.anthropic.com/v1   # Anthropic: .../v1 ; Ollama: http://localhost:11434/v1
LLM_API_KEY=                       # klucz dostawcy (pusty dla Ollama)
LLM_MODEL=claude-sonnet-4-6        # Ollama np. llama3.1 ; OpenAI np. gpt-4o

# --- Vision ---
# Ścieżka do wytrenowanego modelu YOLO (gracze/piłka/sędzia). Pusta = pobierz/dotrenuj.
YOLO_MODEL_PATH=
# Co która klatka jest analizowana (1 = każda; większe = szybciej, mniej dokładnie).
FRAME_STRIDE=5
# Sekundy przed/po evencie wycinane do klipu highlightu.
CLIP_PRE_SECONDS=6
CLIP_POST_SECONDS=4

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
