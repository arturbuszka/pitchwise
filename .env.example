# Skopiuj do .env i uzupełnij klucz LLM przed docker compose up

# --- LLM ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Vision (tryb inline — bez Redis, wygodne do MVP) ---
ANALYSIS_INLINE=1
FRAME_STRIDE=5
CLIP_PRE_SECONDS=6
CLIP_POST_SECONDS=4

# --- Storage (ścieżki wewnątrz kontenera api) ---
STORAGE_DIR=/app/storage
DATABASE_URL=sqlite+aiosqlite:////app/storage/app.db

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
