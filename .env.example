# Copy to .env and fill in your LLM key before `docker compose up`

# --- LLM ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Vision ---
FRAME_STRIDE=5
CLIP_PRE_SECONDS=6
CLIP_POST_SECONDS=4

# --- Storage (paths inside the containers) ---
STORAGE_DIR=/app/storage

# --- CORS ---
WEB_ORIGIN=http://localhost:3000
